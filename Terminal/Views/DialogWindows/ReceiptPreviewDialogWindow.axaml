<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogWindows="clr-namespace:Terminal.ViewModels.DialogWindows"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="840"
        x:Class="Terminal.Views.DialogWindows.ReceiptPreviewDialogWindow"
        x:DataType="dialogWindows:ReceiptPreviewDialogViewModel"
        Title="Предпросмотр чека" Width="400" Height="600" 
        WindowStartupLocation="CenterOwner" CanResize="False">
    
    <ScrollViewer>
        <TextBlock Text="{Binding ReceiptText}" 
                   HorizontalAlignment="Center"
                   FontFamily="Courier New"
                   FontSize="12"
                   TextWrapping="Wrap"/>
    </ScrollViewer>
</Window>
