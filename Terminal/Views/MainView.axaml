<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Terminal.ViewModels"
             xmlns:converters="clr-namespace:Terminal.Converters"
             xmlns:models="clr-namespace:Terminal.Core.Entities.Models;assembly=Terminal.Core"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="840"
             x:Class="Terminal.Views.MainView"
             x:DataType="vm:MainViewModel">
    
    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:PopupTypeToBrushConverter x:Key="PopupTypeToBrushConverter"/>
    </UserControl.Resources>
    
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Height="25" Background="WhiteSmoke" Padding="25,0,25,0">
            <Grid Margin="8,0" ColumnDefinitions="*">
                <!-- Иконки статусов -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding StatusList}"
                              Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding IconName, Converter={StaticResource PathToImageConverter}}" 
                                   Width="16" 
                                   Height="16"
                                   Margin="0,0,6,0"
                                   ToolTip.Tip="{Binding Type}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        
        <Panel Grid.Row="1">
            <!-- Основной контент -->
            <TransitioningContentControl Content="{Binding CurrentPage}" />
            
            <!-- Стек всплывающих уведомлений -->
            <ItemsControl ItemsSource="{Binding Popups}"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          Margin="10,0,10,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Popup">
                        <Border Padding="12,8"
                                CornerRadius="4"
                                Background="{Binding Type, Converter={StaticResource PopupTypeToBrushConverter}}">
                            <TextBlock Text="{Binding Message}"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       FontSize="14" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Panel>
    </Grid>
</UserControl>
