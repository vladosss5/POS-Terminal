<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Terminal.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Terminal.Views.Pages.ConfirmationPageView"
             x:DataType="pages:ConfirmationPageViewModel">
    
    <Grid RowDefinitions="*, *, *" Margin="15">
        <TextBlock Grid.Row="0" Text="{Binding Title}" 
                   Classes="page-title"
                   FontSize="35"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="20"/>
        
        <TextBlock Grid.Row="1" Text="{Binding ConfirmationText}" 
                   Classes="page-title"
                   FontSize="30"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"/>
        
        <Grid Grid.Row="2"
              RowDefinitions="*, *"
              VerticalAlignment="Stretch"
              Margin="10">
            <!-- Отмена -->
            <Button Grid.Row="0" Command="{Binding Exit}"
                    Classes="action-button" 
                    Background="#0078D4">
                <TextBlock Text="Отмена" 
                           Classes="action-text"/>
            </Button>
            
            <!-- Подтвердить -->
            <Button Grid.Row="1" Command="{Binding Confirm}"
                    Classes="action-button">
                <TextBlock Text="Подтвердить"
                           Classes="action-text"/>
            </Button>
        </Grid>
    </Grid>
    
    <UserControl.Styles>
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
        </Style>
        
        <Style Selector="TextBlock.action-text">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
</UserControl>
