<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Terminal.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Terminal.Views.Pages.SettingsPrintPageView"
             x:DataType="pages:SettingsPrintPageViewModel"
             x:Name="ThisUserControl">
    
    <UserControl.Styles>
        <Style Selector="TextBlock.text-items-control">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
        </Style>
        
        <Style Selector="ToggleSwitch.setting-switcher">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        
        <Style Selector="Separator.default-separator">
            <Setter Property="Background" Value="LightGray"/>
        </Style>
        
        <Style Selector="Border.group-setting">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="Padding" Value="0,10,0,10"></Setter>
        </Style>
        
        <Style Selector="TextBlock.group-title">
            <Setter Property="Margin" Value="10,0,0,10"/>
            <Setter Property="Foreground" Value="#7a7a7a"/>
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <TextBlock Grid.Column="0" 
                       Text="{Binding Title}"
                       Classes="page-title"/>
            
            <Button Grid.Column="1" HorizontalAlignment="Right"
                    Command="{Binding GoBackCommand}"
                    MaxHeight="60"
                    Background="Transparent" CornerRadius="50">
                <Image Source="../../Assets/arrow-left.png"/>
            </Button>
        </Grid>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Border Classes="group-setting">
                    <StackPanel >
                        <TextBlock Text="Копирование чеков" Classes="group-title"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Топливный чек" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Дисконтный чек" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Платёжный чек" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Ведомственный чек" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Border Classes="group-setting">
                    <StackPanel >
                        <TextBlock Text="Состав чека" Classes="group-title"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Бонусная программа" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Сумма чека" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Блок продаж" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Цена" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Border Classes="group-setting">
                    <StackPanel>
                        <TextBlock Text="Отчёты" Classes="group-title"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Итоговое кол-во" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Итоговая скидка" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Итоги эмитентов" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Делить эмитент" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Делить по топливу" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Border Classes="group-setting">
                    <StackPanel>
                        <TextBlock Text="Прочее" Classes="group-title"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Удалять корректировки" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
