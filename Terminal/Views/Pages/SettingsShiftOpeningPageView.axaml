<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Terminal.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Terminal.Views.Pages.SettingsShiftOpeningPageView"
             x:DataType="pages:SettingsShiftOpeningPageViewModel"
             x:Name="ThisUserControl">
    
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <TextBlock Grid.Column="0" 
                   Text="{Binding Title}"
                   Classes="page-title"/>
            
            <Button Grid.Column="1" HorizontalAlignment="Right"
                    Command="{Binding GoBackCommand}"
                    MaxHeight="60"
                    Background="Transparent" CornerRadius="50">
                <Image Source="../../Assets/arrow-left.png"/>
            </Button>
        </Grid>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Border Classes="group-setting">
                    <StackPanel >
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Ожидание ввода пароля" Classes="text-items-control"/>
                            
                            <ComboBox Grid.Column="1" Classes="selector-box"
                                      ItemsSource="{Binding TimeoutValues}"
                                      SelectedItem="{Binding SecondsAuthenticationCanceled}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Аутентифицировать по" Classes="text-items-control"/>
                            
                            <ComboBox Grid.Column="1" Classes="selector-box"
                                      ItemsSource="{Binding LoadModes}"
                                      SelectedItem="{Binding SelectedAuthorizeType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumFriendlyNameConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Separator Classes="default-separator"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Помнить пароль" Classes="text-items-control"/>
                            <ToggleSwitch Grid.Column="1" Classes="setting-switcher"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    
    
    
    <UserControl.Styles>
        <Style Selector="TextBlock.text-items-control">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
        </Style>
        
        <Style Selector="ToggleSwitch.setting-switcher">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        
        <Style Selector="Separator.default-separator">
            <Setter Property="Background" Value="LightGray"/>
        </Style>
        
        <Style Selector="Border.group-setting">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="Padding" Value="0,10,0,10"></Setter>
        </Style>
        
        <Style Selector="TextBlock.group-title">
            <Setter Property="Margin" Value="10,0,0,10"/>
            <Setter Property="Foreground" Value="#7a7a7a"/>
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>
        
        <Style Selector="ComboBox.selector-box">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"></Setter>
        </Style>
    </UserControl.Styles>
</UserControl>
