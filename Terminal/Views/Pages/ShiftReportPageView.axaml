<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Terminal.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="840"
             x:Class="Terminal.Views.Pages.ShiftReportPageView"
             x:DataType="pages:ShiftReportPageViewModel">
    <UserControl.Styles>
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="15"></Setter>
        </Style>
        <Style Selector="TextBlock.action-text">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto, *, 100">
        <!-- Шапка -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <TextBlock Grid.Column="0" 
                       Text="Отчёт" 
                       Classes="page-title"
                       Foreground="Black"/>
            
            <Button Grid.Column="1" HorizontalAlignment="Right"
                    Command="{Binding Close}"
                    MaxHeight="60"
                    Background="Transparent" CornerRadius="50">
                <Image Source="../../Assets/Icons/arrow-left.png"/>
            </Button>
        </Grid>
        
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ReceiptLines}"
                 Background="White"
                 BorderThickness="0">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="0.5" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontFamily="{StaticResource HaskligMedium}"
                               FontSize="14"
                               Foreground="Black"
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsEnabled" Value="False"/>
                </Style>
            </ListBox.Styles>
        </ListBox>
        
        <Button Grid.Row="2"
                Command="{Binding Print}" 
                Classes="action-button" 
                Background="#0078D4">
            <TextBlock Text="Печать" Classes="action-text"/>
        </Button>
    </Grid>
</UserControl>
