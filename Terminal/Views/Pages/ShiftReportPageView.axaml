<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Terminal.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Terminal.Views.Pages.ShiftReportPageView"
             x:DataType="pages:ShiftReportPageViewModel">
    
    <Grid RowDefinitions="*, Auto">
        <ScrollViewer Grid.Row="0">
            <TextBlock Text="{Binding ReceiptText}" 
                       HorizontalAlignment="Center"
                       FontFamily="Courier New"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <Button Grid.Column="0" Content="Закрыть" Command="{Binding Close}"/>
            <Button Grid.Column="1" Content="Печать" Command="{Binding Print}"/>
        </Grid>
    </Grid>
</UserControl>
